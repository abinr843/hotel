{
  "info": {
    "name": "Hotel POS E2E Collection",
    "description": "Comprehensive collection covering all endpoints for the Hotel POS backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Menu Management",
      "item": [
        {
          "name": "List Menu Items",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/menu/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "menu",
                ""
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Order Flow",
      "item": [
        {
          "name": "Create Draft Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                ""
              ]
            }
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"action\": \"add\",\n    \"menu_item_id\": 1,\n    \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders/1/cart_action/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "1",
                "cart_action",
                ""
              ]
            }
          }
        },
        {
          "name": "Checkout Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"payment_method\": \"CASH\",\n    \"cash_tendered\": 500.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders/1/checkout/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "1",
                "checkout",
                ""
              ]
            }
          }
        },
        {
          "name": "Void Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"void_pin\": \"1234\",\n    \"reason\": \"Customer changed mind\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders/1/void_order/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "1",
                "void_order",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. EOD Settlement",
      "item": [
        {
          "name": "Preview Settlement",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/settlements/preview/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "settlements",
                "preview",
                ""
              ]
            }
          }
        },
        {
          "name": "Settle Shift",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"physical_cash_counted\": 2500.00,\n    \"notes\": \"All good\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/settlements/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "settlements",
                ""
              ]
            }
          }
        }
      ]
    }
  ]
}
